# ── MySQL ─────────────────────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=changeme_root
MYSQL_DATABASE=tcgdb
MYSQL_USER=tcguser
MYSQL_PASSWORD=changeme_user

# ── JWT Secrets ───────────────────────────────────────────────────────────────
# Generate secure values with: openssl rand -hex 32
JWT_ACCESS_SECRET=replace_with_at_least_32_char_random_string
JWT_REFRESH_SECRET=replace_with_different_32_char_random_string

# ── Token expiry (optional — defaults shown) ──────────────────────────────────
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
